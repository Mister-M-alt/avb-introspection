#
# systemd unit for the backend (VM/bare-metal deployments fronted by nginx —
# see deploy/nginx.production.conf, or deploy/nginx.conf for a lab).
#
# Install (or run deploy/install.sh from a release bundle, which does this):
#   sudo useradd --system --home /var/lib/avb-introspection avb
#   sudo mkdir -p /opt/avb-introspection
#   sudo cp build/avb-introspectd /opt/avb-introspection/
#   sudo cp -r frontend /opt/avb-introspection/
#   sudo cp deploy/avb-introspectd.service /etc/systemd/system/
#   sudo install -d -m 0750 /etc/avb-introspection
#   sudo $EDITOR /etc/avb-introspection/env       # see below; chmod 0600
#   sudo systemctl enable --now avb-introspectd
# The data directory is created and owned for you (StateDirectory=).

[Unit]
Description=AVB Introspection backend (Milan protocol analyzer)
Documentation=https://github.com/Mister-M-alt/avb-introspection
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=avb
Group=avb
# All configuration comes from /etc/avb-introspection/env (KEY=VALUE lines,
# mode 0600, root-owned). It is optional (leading "-") so the unit also runs
# without one. Unlike Environment= in a drop-in, an EnvironmentFile does no
# specifier expansion, so a password containing % or $ survives intact.
#
#   AVB_ADMIN_USER=alex                 # created as admin on first start, or
#   AVB_ADMIN_PASSWORD=change-me        # promoted if it exists (password then ignored)
#   AVB_DISABLE_REGISTRATION=1          # admins/owners create accounts
#   AVB_RATE_RPS=30 / AVB_RATE_BURST=90 # per non-admin user (defaults)
#   AVB_LOGIN_RPS=0.5 / AVB_LOGIN_BURST=6   # per client IP on login/register
#   AVB_TRUSTED_PROXIES=10.20.0.5       # ONLY if nginx runs on ANOTHER host:
#                                       # the app believes X-Real-IP from
#                                       # loopback and these peers, nobody else
EnvironmentFile=-/etc/avb-introspection/env
# Listen on loopback only — nginx (which terminates TLS) is the sole public
# listener. If nginx runs on another machine on a trusted segment, bind the
# app-VLAN address instead (e.g. --bind 10.30.0.10), widen IPAddressAllow=
# below to that nginx host, and set AVB_TRUSTED_PROXIES to it.
ExecStart=/opt/avb-introspection/avb-introspectd \
    --bind 127.0.0.1 \
    --port 8342 \
    --data /var/lib/avb-introspection \
    --frontend /opt/avb-introspection/frontend
Restart=on-failure
RestartSec=2
# SIGTERM starts a graceful stop: listener closed, WebSocket streams sent a
# 1001 close frame, in-flight requests finished, then exit 0. A second SIGTERM
# exits at once. Allow longer than your largest upload takes to validate.
KillSignal=SIGTERM
TimeoutStopSec=60

# ── Hardening (see docs/SECURITY.md §3) ──────────────────────────────────
# The goal: a full compromise of the process can touch nothing but its own
# data directory and cannot open an outbound connection.
#
# StateDirectory= creates /var/lib/avb-introspection owned by avb and makes
# it the one writable path under ProtectSystem=strict. If an admin points
# the pcap library at a path outside it (Admin → Storage), add that path to
# ReadWritePaths= too, e.g.:
#   ReadWritePaths=/mnt/captures
# otherwise the new root is read-only and the change is rejected with a
# "not writable by the service" error.
StateDirectory=avb-introspection
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/avb-introspection
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
# Drop every Linux capability — the daemon needs none.
CapabilityBoundingSet=
AmbientCapabilities=
# Only ordinary sockets (no AF_PACKET raw-packet spoofing, no AF_NETLINK).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# cgroup-level egress firewall: the process literally cannot connect anywhere
# but loopback — it cannot phone home even if the host firewall is missing.
# This ALSO blocks inbound from off-box, which is what you want when nginx runs
# on THIS host (the recommended layout: nginx terminates TLS and proxies to
# 127.0.0.1:8342). If nginx runs on another machine, add that host (and change
# --bind above), e.g.:
#   IPAddressAllow=localhost 10.20.0.5
IPAddressAllow=localhost
IPAddressDeny=any
# seccomp allow-list: @reboot, @swap, @module, @raw-io, @mount, … are denied.
# @process stays allowed so the daemon can fork/exec the decompression tools.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077

# ── Resource quotas — one tenant or a decode storm cannot down the host ──
# Uploads are buffered in RAM at roughly 3x their size: with the default
# --max-upload-mb 1024 a 2G cap can be hit by a single large upload. Either
# raise MemoryMax or add --max-upload-mb 512 to ExecStart (and lower nginx's
# client_max_body_size to match). docs/CONTAINER.md §8 has the arithmetic.
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2G
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
