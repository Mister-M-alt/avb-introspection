# Per-shard environment for deploy/docker-compose.scale.yml.
# Copy to initech.env (mode 0600) and fill in a real password.
# Reference: docs/CONTAINER.md §4.

AVB_ADMIN_USER=initech-admin
AVB_ADMIN_PASSWORD=CHANGE-ME-generate-a-strong-one
AVB_DISABLE_REGISTRATION=1

# Trusted reverse proxies (X-Real-IP) are set per shard in the compose file
# (AVB_TRUSTED_PROXIES); set it here only to override for this shard.
