#
# Environment for the single-instance stack (deploy/docker-compose.yml).
# Copy to app.env (mode 0600) and fill in a real password:
#
#   cp app.env.example app.env && chmod 600 app.env
#
# The compose file refuses to start without this file — by design, so that a
# remote deployment never comes up with the "first account becomes admin"
# bootstrap open. Reference: docs/DEPLOYMENT.md, docs/SECURITY.md §6.

AVB_ADMIN_USER=admin
AVB_ADMIN_PASSWORD=CHANGE-ME-generate-a-strong-one

# Admins/owners create accounts; no open self-registration on an exposed box.
AVB_DISABLE_REGISTRATION=1

# Per-non-admin API rate limit (defaults 30 / 90) and per-IP login throttle
# (defaults 0.5 / 6).
# AVB_RATE_RPS=30
# AVB_RATE_BURST=90
# AVB_LOGIN_RPS=0.5
# AVB_LOGIN_BURST=6

# Which reverse proxies' X-Real-IP is believed. The compose file already sets
# this for its own internal network; set it here only to override.
# AVB_TRUSTED_PROXIES=10.201.0.0/24
