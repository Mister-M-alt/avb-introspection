#
# Per-shard environment for deploy/docker-compose.scale.yml.
# Copy to acme.env (mode 0600) and fill in a real password:
#
#   cp acme.env.example acme.env && chmod 600 acme.env
#
# Each shard is an independent deployment with its own user database, so it
# needs its own admin. Do not reuse one password across shards.
# Reference: docs/CONTAINER.md §4, docs/SECURITY.md.

AVB_ADMIN_USER=acme-admin
AVB_ADMIN_PASSWORD=CHANGE-ME-generate-a-strong-one

# Admins/owners create accounts; no open self-registration on an exposed box.
AVB_DISABLE_REGISTRATION=1

# Per-non-admin API rate limit (defaults 30 / 90) and per-IP login throttle
# (defaults 0.5 / 6). Tune per tenant if one has heavier automation.
# AVB_RATE_RPS=30
# AVB_RATE_BURST=90
# AVB_LOGIN_RPS=0.5
# AVB_LOGIN_BURST=6

# Trusted reverse proxies (X-Real-IP) are set per shard in the compose file
# (AVB_TRUSTED_PROXIES); set it here only to override for this shard.
